{
  "name": "@zupertools/form-react",
  "version": "0.3.1",
  "description": "zuperform: React form library based on Zod",
  "keywords": [
    "form",
    "react",
    "typescript",
    "validation",
    "zod",
    "zuperform"
  ],
  "license": "MIT",
  "author": "Theodor Lundin",
  "repository": {
    "url": "https://github.com/zupertools/zuperform/"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest"
  },
  "dependencies": {
    "@zupertools/form-core": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "zod": ">=4"
  }
}
